% Citations
% for the moment, I just use the standard cite command, but at some point I want to improve it so that it is inline
\newcommand{\mycite}[2][]{\cite[#2]{#1}}

% the following code generated by copilot seems to be buggy:

% Inline citation: author, title, year (no citation hyperlink).
% Optional first argument can be used for a pinpoint, e.g. \incite[Lemma 3]{key}.
\newcommand{\incite}[2][]{%
    \textup{\NoHyper\citeauthor{#2}, \mkbibemph{\citefield{#2}{title}}, \citeyear{#2}\endNoHyper}%
    \if\relax\detokenize{#1}\relax\else\textup{, #1}\fi%
}

% Block-style inline citation: left-indented with vertical space above/below.
\newcommand{\inciteblock}[2][]{%
    \par\smallskip
    \noindent\hspace*{3em}\parbox[t]{\dimexpr\linewidth-2em\relax}{\incite[#1]{#2}}%
    \par\smallskip
}