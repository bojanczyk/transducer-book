% ********* document structure *********
% macro for parts (larger than sections)
\newcounter{mypart}
\renewcommand{\themypart}{\Alph{mypart}}

% redefine section numbering to include part letter
\renewcommand{\thesection}{\themypart.\arabic{section}}

% adjust TOC section number width to accommodate part letter
\makeatletter
\renewcommand*\l@section{\@dottedtocline{1}{1em}{2em}}
\renewcommand*\l@subsection{\@dottedtocline{2}{3em}{4em}}
\makeatother

\newcommand{\mypart}[1]{
\refstepcounter{mypart}
\setcounter{section}{0}
\newpage
\addcontentsline{toc}{part}{Part \themypart: #1}
\addtocontents{toc}{\vspace{0.5em}}
\begin{center}
    \vspace*{2cm}
    {\Large\bfseries Part \themypart: #1}
    \vspace{2cm}
\end{center}
}



