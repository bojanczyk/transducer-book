/-
Part D, Section *Evaluation*: the proof of the Factorisation Forest Theorem
(`thm:factorisation-forest`).

The book proves the theorem for semigroup homomorphisms `A⁺ → S`, by induction on the size of the
semigroup and on the number of semigroup elements that are images of letters.  Here the same
induction is carried out inside one finite monoid `M`: the semigroups of the induction are finite
subsets `T ⊆ M` closed under multiplication (`Transducers.Simon.Closed`), and the images of the
letters form a subset `L ⊆ T`.  `Transducers.Simon.Good L` says that there is a bound `K` such that
every nonempty string, over any alphabet whatsoever, whose letters all have values in `L`, has a
Simon tree of height at most `K`.

* `good_single` is the case of a single letter value (Lemma
  `lem:factorisation-forest-single-letter`).
* `good_shrink` is the induction step of Lemma `lem:factorisation-forest-shrinking-letter`: if
  `s ∈ L` and the bounds are known for the letter values `L \ {s}` and for the subsemigroup `T·s`,
  then the bound holds for `L`.
* `good_group` is Lemma `lem:factorisation-forest-group`, in the form in which the proof uses it:
  the semigroup `T` only needs left multiplication by each of its elements to be injective on `T`
  (which is the case in a group).  The bound is `3·|T|`, as in the book.
* `good_closed` puts them together.  When no letter shrinks `T` on the right, either `T` is not
  generated by the letter values, and the induction hypothesis applies to the subsemigroup they
  generate, or right multiplication by every element of `T` is injective on `T`, and `good_group`
  applies in the opposite monoid.  So only the right-hand version of
  `lem:factorisation-forest-shrinking-letter` is needed; the book's symmetric argument is replaced by
  reading the string backwards (`Transducers.Simon.Bnd.reverse`) in the group case.
-/
import RequestProject.PartD.SimonBound

namespace Transducers

namespace Simon

open Finset

variable {M : Type} [Monoid M]

/-- `Good L`: there is a bound `K` such that every nonempty string, over any alphabet, all of whose
letters have values in `L`, has a Simon tree of height at most `K`. -/
def Good (L : Finset M) : Prop :=
  ∃ K : ℕ, ∀ (X : Type) (φ : X → M) (w : List X), w ≠ [] → (∀ x ∈ w, φ x ∈ L) → Bnd φ K w

/-- A finite subset of the monoid that is closed under multiplication: a finite subsemigroup. -/
def Closed (T : Finset M) : Prop := ∀ a ∈ T, ∀ b ∈ T, a * b ∈ T

lemma Good.mono {L L' : Finset M} (h : Good L) (hL : L' ⊆ L) : Good L' := by
  obtain ⟨K, hK⟩ := h
  exact ⟨K, fun X φ w hw hx => hK X φ w hw fun x hxw => hL (hx x hxw)⟩

lemma good_empty : Good (∅ : Finset M) := by
  refine ⟨0, fun X φ w hw hx => ?_⟩
  obtain ⟨x, hxw⟩ := List.exists_mem_of_ne_nil w hw
  simpa using hx x hxw

variable {X : Type}

lemma val_mem {T : Finset M} (hT : Closed T) {φ : X → M} :
    ∀ {w : List X}, w ≠ [] → (∀ x ∈ w, φ x ∈ T) → val φ w ∈ T
  | [], h, _ => absurd rfl h
  | [x], _, hx => by simpa using hx x (by simp)
  | x :: y :: w, _, hx => by
    rw [val_cons]
    exact hT _ (hx x (by simp)) _ (val_mem hT (by simp) fun z hz => hx z (by simp [hz]))

lemma val_const {φ : X → M} {s : M} : ∀ {w : List X}, (∀ x ∈ w, φ x = s) → val φ w = s ^ w.length
  | [], _ => by simp
  | x :: w, h => by
    rw [val_cons, h x (by simp), val_const (fun y hy => h y (by simp [hy])), List.length_cons,
      pow_succ']

/-- In a finite monoid every element has a positive power that is an idempotent. -/
lemma exists_isIdempotentElem_pow [Finite M] (s : M) :
    ∃ p : ℕ, 0 < p ∧ IsIdempotentElem (s ^ p) := by
  obtain ⟨i, j, hij, heq⟩ := Finite.exists_ne_map_eq_of_infinite (fun n : ℕ => s ^ n)
  wlog hlt : i < j generalizing i j
  · exact this j i hij.symm heq.symm (lt_of_le_of_ne (not_lt.mp hlt) hij.symm)
  set d := j - i with hd
  have hd0 : 0 < d := by omega
  have hstep : ∀ n, i ≤ n → s ^ (n + d) = s ^ n := by
    intro n hn
    have : n + d = (n - i) + j := by omega
    rw [this, pow_add, ← heq, ← pow_add]
    congr 1
    omega
  have hper : ∀ c n, i ≤ n → s ^ (n + c * d) = s ^ n := by
    intro c
    induction c with
    | zero => simp
    | succ c ih =>
      intro n hn
      have : n + (c + 1) * d = (n + c * d) + d := by ring
      rw [this, hstep _ (by omega), ih n hn]
  refine ⟨(i + 1) * d, Nat.mul_pos (by omega) hd0, ?_⟩
  show s ^ ((i + 1) * d) * s ^ ((i + 1) * d) = s ^ ((i + 1) * d)
  rw [← pow_add, hper (i + 1) _ (by nlinarith)]

lemma exists_chunks (p : ℕ) :
    ∀ (c : ℕ) (w : List X), w.length = c * p →
      ∃ us : List (List X), us.flatten = w ∧ us.length = c ∧ ∀ u ∈ us, u.length = p
  | 0, w, h => ⟨[], by simpa using (List.length_eq_zero_iff.mp (by simpa using h)).symm, rfl,
      by simp⟩
  | c + 1, w, h => by
    obtain ⟨us, h1, h2, h3⟩ := exists_chunks p c (w.drop p) (by
      rw [List.length_drop, h]; rw [Nat.succ_mul]; omega)
    refine ⟨w.take p :: us, by simp [h1], by simp [h2], ?_⟩
    intro u hu
    simp only [List.mem_cons] at hu
    rcases hu with rfl | hu
    · rw [List.length_take, h]; rw [Nat.succ_mul]; omega
    · exact h3 u hu

/-- **The case of a single letter value** (Lemma `lem:factorisation-forest-single-letter`, in the
form used by the induction).  If `s^p` is an idempotent, every string whose letters all have value
`s` has a Simon tree of height at most `2p`: the string is cut into factors of length `p`, which
are grouped under one idempotent node, and the fewer than `p` remaining letters are added one by
one. -/
theorem good_single [Finite M] (s : M) : Good ({s} : Finset M) := by
  obtain ⟨p, hp, he⟩ := exists_isIdempotentElem_pow s
  refine ⟨2 * p, fun X φ w hw hx => ?_⟩
  have hxs : ∀ x ∈ w, φ x = s := fun x hx' => by simpa using hx x hx'
  set q := w.length / p
  have hsplit : w = w.take (q * p) ++ w.drop (q * p) := (List.take_append_drop _ _).symm
  have hrest : (w.drop (q * p)).length < p := by
    rw [List.length_drop]
    have := Nat.mod_lt w.length hp
    have h2 : q * p + w.length % p = w.length := by
      rw [Nat.mul_comm]; exact Nat.div_add_mod w.length p
    omega
  rcases Nat.eq_zero_or_pos q with hq | hq
  · have hlen : w.length < p := by
      have := Nat.div_add_mod w.length p
      rw [show w.length / p = q from rfl, hq] at this
      have := Nat.mod_lt w.length hp
      omega
    exact (Bnd.of_ne_nil hw).mono (by omega)
  · have hlen : (w.take (q * p)).length = q * p := by
      rw [List.length_take]
      have : q * p ≤ w.length := by
        have := Nat.div_mul_le_self w.length p
        exact this
      omega
    obtain ⟨us, hus, husl, husp⟩ := exists_chunks p q _ hlen
    have hne : us ≠ [] := by
      intro h; rw [h] at husl; simp at husl; omega
    have hmem : ∀ u ∈ us, ∀ x ∈ u, x ∈ w := by
      intro u hu x hxu
      have : x ∈ w.take (q * p) := by rw [← hus]; exact List.mem_flatten.mpr ⟨u, hu, hxu⟩
      exact List.mem_of_mem_take this
    have hgroup : Bnd φ (p - 1 + 1) us.flatten := by
      refine Bnd.group hne he ?_ ?_
      · intro u hu
        have hu' : u ≠ [] := by
          intro h; have := husp u hu; rw [h] at this; simp at this; omega
        have := Bnd.of_ne_nil (φ := φ) hu'
        rwa [husp u hu] at this
      · intro u hu
        rw [val_const (fun x hxu => hxs x (hmem u hu x hxu)), husp u hu]
    rw [hus] at hgroup
    rw [hsplit]
    exact (hgroup.append_short _).mono (by omega)

/-! ## The induction step: a letter that shrinks the semigroup on the right -/

/-- The decomposition `A* = C* × (B⁺ × C⁺)* × B*` of the book, for the letters `C` that satisfy a
predicate `P` and the letters `B` that do not. -/
lemma exists_decomp (P : X → Prop) [DecidablePred P] :
    ∀ w : List X, ∃ (c₀ : List X) (ps : List (List X × List X)) (bl : List X),
      w = c₀ ++ ps.flatMap (fun p => p.1 ++ p.2) ++ bl ∧ (∀ x ∈ c₀, P x) ∧
      (∀ p ∈ ps, p.1 ≠ [] ∧ p.2 ≠ [] ∧ (∀ x ∈ p.1, ¬ P x) ∧ ∀ x ∈ p.2, P x) ∧
      ∀ x ∈ bl, ¬ P x
  | [] => ⟨[], [], [], by simp, by simp, by simp, by simp⟩
  | x :: w => by
    obtain ⟨c₀, ps, bl, hw, hc, hps, hbl⟩ := exists_decomp P w
    by_cases hx : P x
    · refine ⟨x :: c₀, ps, bl, by simp [hw], ?_, hps, hbl⟩
      intro y hy
      simp only [List.mem_cons] at hy
      rcases hy with rfl | hy
      · exact hx
      · exact hc y hy
    · rcases c₀ with _ | ⟨c, c₀⟩
      · rcases ps with _ | ⟨⟨b, c⟩, ps⟩
        · refine ⟨[], [], x :: bl, by simp [hw], by simp, by simp, ?_⟩
          intro y hy
          simp only [List.mem_cons] at hy
          rcases hy with rfl | hy
          · exact hx
          · exact hbl y hy
        · refine ⟨[], (x :: b, c) :: ps, bl, by simp [hw], by simp, ?_, hbl⟩
          intro p hp
          simp only [List.mem_cons] at hp
          rcases hp with rfl | hp
          · obtain ⟨-, h2, h3, h4⟩ := hps (b, c) (by simp)
            refine ⟨by simp, h2, ?_, h4⟩
            intro y hy
            simp only [List.mem_cons] at hy
            rcases hy with rfl | hy
            · exact hx
            · exact h3 y hy
          · exact hps p (by simp [hp])
      · refine ⟨[], ([x], c :: c₀) :: ps, bl, by simp [hw], by simp, ?_, hbl⟩
        intro p hp
        simp only [List.mem_cons] at hp
        rcases hp with rfl | hp
        · refine ⟨by simp, by simp, ?_, hc⟩
          intro y hy
          simp only [List.mem_singleton] at hy
          rw [hy]; exact hx
        · exact hps p (by simp [hp])

lemma flatMap_eq_map_flatMap_id {α β : Type*} (f : α → List β) :
    ∀ l : List α, l.flatMap f = (l.map f).flatMap id
  | [] => rfl
  | a :: l => by simp [flatMap_eq_map_flatMap_id f l]

/-- A string that is empty or has a Simon tree of height at most `n`. -/
def BndE (φ : X → M) (n : ℕ) (w : List X) : Prop := w = [] ∨ Bnd φ n w

lemma BndE.append {φ : X → M} {n m : ℕ} {u w : List X} (hu : BndE φ n u) (hw : BndE φ m w) :
    BndE φ (max n m + 1) (u ++ w) := by
  rcases hu with rfl | hu
  · rcases hw with rfl | hw
    · left; rfl
    · right; simpa using hw.mono (by omega)
  · rcases hw with rfl | hw
    · right; simpa using hu.mono (by omega)
    · right; exact hu.append hw

lemma BndE.mono {φ : X → M} {n m : ℕ} {w : List X} (h : BndE φ n w) (hnm : n ≤ m) :
    BndE φ m w := h.imp id fun h => h.mono hnm

lemma Good.bndE {L : Finset M} (h : Good L) : ∃ K : ℕ, ∀ (X : Type) (φ : X → M) (w : List X),
    (∀ x ∈ w, φ x ∈ L) → BndE φ K w := by
  obtain ⟨K, hK⟩ := h
  refine ⟨K, fun X φ w hx => ?_⟩
  rcases eq_or_ne w [] with rfl | hw
  · left; rfl
  · right; exact hK X φ w hw hx

/-- **The induction step of Lemma `lem:factorisation-forest-shrinking-letter`.**  Let `s` be the
value of some letters.  If strings over the other letter values have Simon trees of bounded height,
and so do strings over the subsemigroup `T·s`, then all strings have Simon trees of bounded height.
(The induction hypothesis applies to `T·s` when it is a proper subset of `T`.) -/
theorem good_shrink [Finite M] [DecidableEq M] {T L : Finset M} (hT : Closed T) (hLT : L ⊆ T) {s : M}
    (hB : Good (L.erase s)) (hC : Good (T.image (· * s))) : Good L := by
  classical
  obtain ⟨KB, hKB⟩ := hB
  obtain ⟨KS, hKS⟩ := good_single s
  obtain ⟨KC, hKC⟩ := hC.bndE
  refine ⟨KS + (KC + (max KB KS + 1)) + KB + 2, fun X φ w hw hx => ?_⟩
  obtain ⟨c₀, ps, bl, hdec, hc₀, hps, hbl⟩ := exists_decomp (fun x => φ x = s) w
  have hmemw : ∀ x, x ∈ c₀ ∨ (∃ p ∈ ps, x ∈ p.1 ∨ x ∈ p.2) ∨ x ∈ bl → x ∈ w := by
    intro x hx'
    rw [hdec]
    rcases hx' with h | ⟨p, hp, h⟩ | h
    · simp [h]
    · simp only [List.mem_append, List.mem_flatMap]
      exact Or.inl (Or.inr ⟨p, hp, h⟩)
    · simp [h]
  -- the factor from `C*`
  have h₀ : BndE φ KS c₀ := by
    rcases eq_or_ne c₀ [] with h | h
    · left; exact h
    · right
      exact hKS X φ c₀ h fun x hxc => by simp [hc₀ x hxc]
  -- the factor from `B*`
  have h₂ : BndE φ KB bl := by
    rcases eq_or_ne bl [] with h | h
    · left; exact h
    · right
      refine hKB X φ bl h fun x hxb => ?_
      exact Finset.mem_erase.mpr ⟨hbl x hxb, hx x (hmemw x (Or.inr (Or.inr hxb)))⟩
  -- the middle factor, from `(B⁺ × C⁺)*`
  set v : List (List X) := ps.map (fun p => p.1 ++ p.2) with hv
  have hblock : ∀ y ∈ v, Bnd φ (max KB KS + 1) y ∧ val φ y ∈ T.image (· * s) := by
    intro y hy
    obtain ⟨⟨b, c⟩, hp, rfl⟩ := List.mem_map.mp hy
    obtain ⟨hb, hc, hbB, hcC⟩ := hps (b, c) hp
    have hbx : ∀ x ∈ b, x ∈ w := fun x hxb => hmemw x (Or.inr (Or.inl ⟨(b, c), hp, Or.inl hxb⟩))
    have hcx : ∀ x ∈ c, x ∈ w := fun x hxc => hmemw x (Or.inr (Or.inl ⟨(b, c), hp, Or.inr hxc⟩))
    refine ⟨?_, ?_⟩
    · refine Bnd.append (hKB X φ b hb fun x hxb => ?_) (hKS X φ c hc fun x hxc => ?_)
      · exact Finset.mem_erase.mpr ⟨hbB x hxb, hx x (hbx x hxb)⟩
      · simp [hcC x hxc]
    · obtain ⟨c', z, rfl⟩ := (List.eq_nil_or_concat c).resolve_left hc
      have hT' : val φ (b ++ c') ∈ T := by
        refine val_mem hT (by simp [hb]) fun x hx' => hLT (hx x ?_)
        rcases List.mem_append.mp hx' with h | h
        · exact hbx x h
        · exact hcx x (by simp [h])
      refine Finset.mem_image.mpr ⟨val φ (b ++ c'), hT', ?_⟩
      have hz : φ z = s := hcC z (by simp)
      simp only [List.concat_eq_append]
      show val φ (b ++ c') * s = val φ (b ++ (c' ++ [z]))
      rw [← List.append_assoc, val_append φ (b ++ c'), val_singleton, hz]
  have h₁ : BndE φ (KC + (max KB KS + 1)) (ps.flatMap (fun p => p.1 ++ p.2)) := by
    rw [flatMap_eq_map_flatMap_id, ← hv]
    rcases hKC (List X) (val φ) v (fun y hy => (hblock y hy).2) with h | h
    · left; simp [h]
    · right
      exact h.subst id (fun y hy => (hblock y hy).1) (fun y _ => rfl)
  have := (h₀.append h₁).append h₂
  rw [← hdec] at this
  rcases this.mono (m := KS + (KC + (max KB KS + 1)) + KB + 2) (by omega) with h | h
  · exact absurd h hw
  · exact h

end Simon

end Transducers
