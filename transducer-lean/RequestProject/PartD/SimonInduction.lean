/-
Part D, Section *Evaluation*: the induction that proves the Factorisation Forest Theorem
(`thm:factorisation-forest`).

The induction is the book's: on the size of the semigroup `T` and, for a fixed `T`, on the number of
semigroup elements that are values of letters (`L ⊆ T`).

* If some letter value `s ∈ L` shrinks `T` on the right (`T·s ≠ T`), then
  `Transducers.Simon.good_shrink` applies, with the induction hypothesis for the letter values
  `L \ {s}` and for the smaller semigroup `T·s` (Lemma `lem:factorisation-forest-shrinking-letter`).
* Otherwise right multiplication by every letter value is a permutation of `T`.  If `T` is not
  generated by the letter values, the induction hypothesis applies to the subsemigroup that they
  generate (the book: "we assume without loss of generality that the semigroup is generated by
  images of letters").  If it is, right multiplication by every element of `T` is injective on `T`,
  so in the opposite monoid left multiplication is, and the group case
  `Transducers.Simon.good_group` applies to the reversed strings.

The book also invokes the symmetric version of the shrinking lemma, to get that left translations
are permutations too, and then Lemma `lem:semigroup-is-group`.  Reading the strings backwards makes
that unnecessary here: the group case only needs one-sided cancellation.
-/
import RequestProject.PartD.SimonGroup

namespace Transducers

namespace Simon

open Finset

variable {M : Type} [Monoid M] [DecidableEq M]

lemma good_op_of_good {L : Finset M} (h : Good L) : Good (L.image MulOpposite.op) := by
  obtain ⟨K, hK⟩ := h
  refine ⟨K, fun X φ w hw hx => ?_⟩
  have h1 := hK X (fun x => (φ x).unop) w.reverse (by simpa using hw) (fun x hx' => by
    obtain ⟨m, hm, hmx⟩ := Finset.mem_image.mp (hx x (List.mem_reverse.mp hx'))
    show (φ x).unop ∈ L
    rw [← hmx]; simpa using hm)
  have h2 := h1.reverse
  simpa using h2

lemma good_of_good_op {L : Finset M} (h : Good (L.image MulOpposite.op)) : Good L := by
  obtain ⟨K, hK⟩ := h
  refine ⟨K, fun X φ w hw hx => ?_⟩
  have h1 := hK X (fun x => MulOpposite.op (φ x)) w.reverse (by simpa using hw) (fun x hx' =>
    Finset.mem_image.mpr ⟨φ x, hx x (List.mem_reverse.mp hx'), rfl⟩)
  exact Bnd.of_reverse h1

omit [DecidableEq M] in
/-- Right multiplication by a product of letter values is injective on `T`, if right
multiplication by every letter value is. -/
lemma injOn_mul_prod {T L : Finset M} (hT : Closed T) (hLT : L ⊆ T)
    (hL : ∀ s ∈ L, Set.InjOn (· * s) T) :
    ∀ w : List M, w ≠ [] → (∀ a ∈ w, a ∈ L) → Set.InjOn (· * w.prod) T
  | [], h, _ => absurd rfl h
  | [a], _, ha => by simpa using hL a (ha a (by simp))
  | a :: b :: w, _, ha => by
    intro x hx y hy hxy
    have ih := injOn_mul_prod hT hLT hL (b :: w) (by simp) (fun c hc => ha c (by simp [hc]))
    have haT : a ∈ T := hLT (ha a (by simp))
    simp only [List.prod_cons] at hxy
    have : x * a = y * a := by
      refine ih (hT _ hx _ haT) (hT _ hy _ haT) ?_
      simp only [List.prod_cons, ← mul_assoc] at hxy ⊢
      simpa [mul_assoc] using hxy
    exact hL a (ha a (by simp)) hx hy this

/-- **The Factorisation Forest Theorem, for finite subsemigroups of a monoid.**  For every finite
subsemigroup `T` of a finite monoid and every set `L ⊆ T` of letter values, the nonempty strings
with letter values in `L` have Simon trees of bounded height. -/
theorem good_closed [Finite M] :
    ∀ (n : ℕ) (T : Finset M), T.card ≤ n → Closed T → ∀ L ⊆ T, Good L := by
  intro n
  induction n with
  | zero =>
    intro T hTc _ L hLT
    have : T = ∅ := Finset.card_eq_zero.mp (by omega)
    subst this
    rw [Finset.subset_empty.mp hLT]
    exact good_empty
  | succ n ihT =>
    intro T hTc hT
    have key : ∀ m, ∀ L ⊆ T, L.card ≤ m → Good L := by
      intro m
      induction m with
      | zero =>
        intro L _ hLc
        have : L = ∅ := Finset.card_eq_zero.mp (by omega)
        rw [this]
        exact good_empty
      | succ m ihL =>
        intro L hLT hLc
        by_cases hshr : ∃ s ∈ L, T.image (· * s) ≠ T
        · obtain ⟨s, hs, hTs⟩ := hshr
          have hsT : s ∈ T := hLT hs
          have hsub : T.image (· * s) ⊆ T := by
            intro m hm
            obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hm
            exact hT _ ht _ hsT
          have hlt : (T.image (· * s)).card < T.card :=
            Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr ⟨hsub, hTs⟩)
          have hclosed : Closed (T.image (· * s)) := by
            intro a ha b hb
            obtain ⟨a', ha', rfl⟩ := Finset.mem_image.mp ha
            obtain ⟨b', hb', rfl⟩ := Finset.mem_image.mp hb
            refine Finset.mem_image.mpr ⟨a' * s * b', hT _ (hT _ ha' _ hsT) _ hb', ?_⟩
            simp [mul_assoc]
          refine good_shrink hT hLT (s := s) ?_ ?_
          · refine ihL (L.erase s) (subset_trans (Finset.erase_subset _ _) hLT) ?_
            rw [Finset.card_erase_of_mem hs]; omega
          · exact ihT _ (by omega) hclosed _ subset_rfl
        · push_neg at hshr
          have hinjL : ∀ s ∈ L, Set.InjOn (· * s) T := fun s hs =>
            Finset.injOn_of_card_image_eq (by rw [hshr s hs])
          classical
          set T₀ := T.filter (fun t => ∃ w : List M, w ≠ [] ∧ (∀ a ∈ w, a ∈ L) ∧ w.prod = t)
          have hT₀T : T₀ ⊆ T := Finset.filter_subset _ _
          have hLT₀ : L ⊆ T₀ := by
            intro a ha
            exact Finset.mem_filter.mpr ⟨hLT ha, [a], by simp, by simpa using ha, by simp⟩
          by_cases hgen : T₀ = T
          · -- `T` is generated by the letter values: right multiplication is injective on `T`
            have hinj : ∀ t ∈ T, Set.InjOn (· * t) T := by
              intro t ht
              rw [← hgen] at ht
              obtain ⟨-, w, hw, hwL, rfl⟩ := Finset.mem_filter.mp ht
              exact injOn_mul_prod hT hLT hinjL w hw hwL
            have hTop : Closed (T.image MulOpposite.op) := by
              intro a ha b hb
              obtain ⟨a', ha', rfl⟩ := Finset.mem_image.mp ha
              obtain ⟨b', hb', rfl⟩ := Finset.mem_image.mp hb
              exact Finset.mem_image.mpr ⟨b' * a', hT _ hb' _ ha', rfl⟩
            have hinjop : ∀ g ∈ T.image MulOpposite.op,
                Set.InjOn (g * ·) (T.image MulOpposite.op : Set Mᵐᵒᵖ) := by
              intro g hg x hx y hy hxy
              obtain ⟨g', hg', rfl⟩ := Finset.mem_image.mp hg
              obtain ⟨x', hx', rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hx)
              obtain ⟨y', hy', rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hy)
              have : x' * g' = y' * g' := by
                have := congrArg MulOpposite.unop hxy
                simpa using this
              rw [hinj g' hg' hx' hy' this]
            obtain ⟨K, -, hK⟩ := good_group hTop hinjop
            refine good_of_good_op (Good.mono ⟨K, hK⟩ ?_)
            exact Finset.image_subset_image hLT
          · -- otherwise the letter values generate a smaller subsemigroup
            have hlt : T₀.card < T.card :=
              Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr ⟨hT₀T, hgen⟩)
            have hclosed : Closed T₀ := by
              intro a ha b hb
              obtain ⟨haT, w₁, hw₁, hw₁L, rfl⟩ := Finset.mem_filter.mp ha
              obtain ⟨hbT, w₂, hw₂, hw₂L, rfl⟩ := Finset.mem_filter.mp hb
              refine Finset.mem_filter.mpr ⟨hT _ haT _ hbT, w₁ ++ w₂, by simp [hw₁], ?_, by simp⟩
              intro c hc
              rcases List.mem_append.mp hc with hc | hc
              · exact hw₁L c hc
              · exact hw₂L c hc
            exact ihT T₀ (by omega) hclosed L hLT₀
    exact fun L hLT => key L.card L hLT le_rfl

/-- Every finite monoid: the nonempty strings, over any alphabet, have Simon trees of bounded
height. -/
theorem good_univ [Fintype M] : Good (Finset.univ : Finset M) :=
  good_closed _ Finset.univ le_rfl (fun _ _ _ _ => Finset.mem_univ _) _ subset_rfl

end Simon

end Transducers
