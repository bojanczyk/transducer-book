/-
Part D, Section *A functional programming language*: the *good functions* of the Fundamental
Lemma, which prove the hard direction of Theorem `thm:higher-order-terms`.

The book proves that direction by the Fundamental Lemma: for every arrow-free parameter type `Q`
and higher-order type `A` one identifies a class of *good* functions of type `Q → A`, which at
arrow-free types are exactly the polyregular ones, and which the parametrised denotation of every
term preserves.  That class is a *logical relation* over the polyregular functions, in the Kripke
form in which the book states it at arrow types -- a change of parameters `r : P → Q` and a good
argument `σ : P → A`.  For a higher-order type `H`, an arrow-free type `P` of Definition
`def:types` (the *parameter*, playing the role of the free variables of a term) and a family

    g : P → H

the relation `Transducers.Rel H P g` says that `g` is *polyregular with parameter `P`*:

* at the unit type, nothing;
* at a product, the two components are related;
* at a co-product, the choice between the two sides is made by a polyregular tag `P → 1 + 1`, and
  the two sides are related;
* at a list type, the list is generated by a polyregular list of *indices*, `P → Q*` for some
  arrow-free `Q`, together with a family `P × Q → A` that is related -- so the entries of the list
  are computed uniformly, from the parameter and from an index;
* at an arrow type, the Kripke condition: the function sends related arguments over any world to
  related results, after any polyregular change of parameter.

The four lemmas of this file are the ones that the fundamental lemma of
`RequestProject/PartD/HOFund.lean` needs: `Transducers.Rel.reindex` (a polyregular change of
parameter preserves the relation), `Transducers.Rel.exists_const` (every type has an element whose
constant family is related -- this is what the empty list term needs), `Transducers.Rel.glue` (the
relation is closed under a case distinction driven by a polyregular tag) and
`Transducers.Rel.iff_polyregular` (at an arrow-free type the relation says exactly that the family
is polyregular under string representation).  The last one is where the map with a parameter of
`RequestProject/PartD/HOPoly.lean` is used, and it is what makes the whole argument work: the
relation is *equivalent* to polyregularity at arrow-free types, so the theorem follows by
instantiating the fundamental lemma at the identity family.

Two of these are numbered results of the book: `Transducers.Rel.iff_polyregular` is Lemma
`lem:good-functions-are-polyregular-at-arrow-free-types`, and `Transducers.Rel.reindex` is Claim
`claim:logical-relations-closed-under-precomposition`.  The definition of a good function itself
carries no `\label` in the book, so it is not aliased in `RequestProject/Labels.lean`.
-/
import RequestProject.PartD.HOPoly
import RequestProject.PartD.HOSyntax

namespace Transducers

open Comb

/-! ## Two more regular functions between types -/

/-- Forgetting which side of a co-product an element is on. -/
theorem isRegularUnderRepr_sumTag (A B : Ty) :
    IsRegularUnderRepr (A := .sum A B) (B := .sum .one .one)
      (fun x => Sum.map (fun _ => ()) (fun _ => ()) x) :=
  IsRegularUnderRepr.sumMap (isRegularUnderRepr_const (A := A) (B := .one) ())
    (isRegularUnderRepr_const (A := B) (B := .one) ())

/-- Reading an element of `A + B` as an element of `A`, by a default value on the right. -/
theorem isRegularUnderRepr_elimDefault (A B : Ty) :
    IsRegularUnderRepr (A := .sum A B) (B := A)
      (fun x => Sum.elim (fun a => a) (fun _ => (default : A.Elt)) x) :=
  IsRegularUnderRepr.copair (isRegularUnderRepr_id A)
    (isRegularUnderRepr_const (A := B) (B := A) default)

/-- Reading an element of `A + B` as an element of `B`, by a default value on the left. -/
theorem isRegularUnderRepr_elimDefaultRight (A B : Ty) :
    IsRegularUnderRepr (A := .sum A B) (B := B)
      (fun x => Sum.elim (fun _ => (default : B.Elt)) (fun b => b) x) :=
  IsRegularUnderRepr.copair (isRegularUnderRepr_const (A := A) (B := B) default)
    (isRegularUnderRepr_id B)

/-! ## The logical relation -/

/-- **The logical relation.**  `Rel H P g` says that the family `g : P → H` of elements of the
higher-order type `H`, depending on a parameter of the arrow-free type `P`, is polyregular in the
parameter -- see the head of the file for the five clauses. -/
def Rel : (H : HTy) → (P : Ty) → (P.Elt → H.Sem) → Prop
  | .one, _, _ => True
  | .prod A B, P, g => Rel A P (fun p => (g p).1) ∧ Rel B P (fun p => (g p).2)
  | .sum A B, P, g => ∃ (a : P.Elt → A.Sem) (b : P.Elt → B.Sem),
      Rel A P a ∧ Rel B P b ∧
      IsPolyregularUnderRepr (A := P) (B := .sum .one .one)
        (fun p => Sum.map (fun _ => ()) (fun _ => ()) (g p)) ∧
      (∀ p, g p = Sum.inl (a p) ∨ g p = Sum.inr (b p))
  | .list A, P, g => ∃ (Q : Ty) (l : P.Elt → List Q.Elt) (e : P.Elt × Q.Elt → A.Sem),
      IsPolyregularUnderRepr (A := P) (B := .list Q) l ∧ Rel A (.prod P Q) e ∧
      (∀ p, g p = (l p).map (fun q => e (p, q)))
  | .arrow A B, P, g => ∀ (Q : Ty) (r : Q.Elt → P.Elt), IsPolyregularUnderRepr r →
      ∀ a : Q.Elt → A.Sem, Rel A Q a → Rel B Q (fun q => g (r q) (a q))

/-- The relation only depends on the values of the family. -/
theorem Rel.congr {H : HTy} {P : Ty} {g g' : P.Elt → H.Sem} (h : Rel H P g)
    (hgg : ∀ p, g p = g' p) : Rel H P g' := by
  have : g = g' := funext hgg
  exact this ▸ h

/-! ## A polyregular change of parameter -/

/-- **Claim `claim:logical-relations-closed-under-precomposition`.**  Good functions are closed
under pre-composition with polyregular ones: the relation is preserved by a polyregular change of
parameter. -/
theorem Rel.reindex : ∀ (H : HTy) {P Q : Ty} {g : P.Elt → H.Sem} {r : Q.Elt → P.Elt},
    Rel H P g → IsPolyregularUnderRepr r → Rel H Q (fun q => g (r q)) := by
  intro H
  induction H with
  | one => intro _ _ _ _ _ _; trivial
  | prod A B ihA ihB =>
      intro P Q g r h hr
      -- the two components are reindexed separately
      exact ⟨ihA (P := P) (Q := Q) h.1 hr, ihB (P := P) (Q := Q) h.2 hr⟩
  | sum A B ihA ihB =>
      intro P Q g r h hr
      obtain ⟨a, b, ha, hb, htag, hcons⟩ := h
      exact ⟨fun q => a (r q), fun q => b (r q), ihA ha hr, ihB hb hr,
        hr.comp htag, fun q => hcons (r q)⟩
  | list A ihA =>
      intro P Q g r h hr
      obtain ⟨Q₀, l, e, hl, he, hg⟩ := h
      refine ⟨Q₀, fun q => l (r q), fun x => e (r x.1, x.2), hr.comp hl, ?_,
        fun q => hg (r q)⟩
      refine ihA (P := .prod P Q₀) (Q := .prod Q Q₀) he ?_
      exact IsPolyregularUnderRepr.prodMap hr
        (isRegularUnderRepr_id Q₀).isPolyregularUnderRepr
  | arrow A B _ _ =>
      intro P Q g r h hr Q' r' hr' a ha
      exact (h Q' (fun q => r (r' q)) (hr'.comp hr) a ha).congr (fun _ => rfl)

/-! ## Constant families -/

/-- **Every higher-order type has an element whose constant family is related**, at every
parameter type.  This is what the empty list term and the default values of the constructions
below need. -/
theorem Rel.exists_const : ∀ H : HTy, ∃ c : H.Sem, ∀ P : Ty, Rel H P (fun _ => c) := by
  intro H
  induction H with
  | one => exact ⟨(), fun _ => trivial⟩
  | prod A B ihA ihB =>
      obtain ⟨cA, hA⟩ := ihA
      obtain ⟨cB, hB⟩ := ihB
      exact ⟨(cA, cB), fun P => ⟨hA P, hB P⟩⟩
  | sum A B ihA ihB =>
      obtain ⟨cA, hA⟩ := ihA
      obtain ⟨cB, hB⟩ := ihB
      refine ⟨Sum.inl cA, fun P => ⟨fun _ => cA, fun _ => cB, hA P, hB P, ?_, fun _ => Or.inl rfl⟩⟩
      exact isPolyregularUnderRepr_const (A := P) (B := .sum .one .one) (Sum.inl ())
  | list A ihA =>
      obtain ⟨cA, hA⟩ := ihA
      refine ⟨[], fun P => ⟨.one, fun _ => [], fun _ => cA, ?_, hA (.prod P .one), fun _ => rfl⟩⟩
      exact isPolyregularUnderRepr_const (A := P) (B := .list .one) []
  | arrow A B _ ihB =>
      obtain ⟨cB, hB⟩ := ihB
      exact ⟨fun _ => cB, fun _ _ _ _ _ _ => hB _⟩

/-! ## Gluing two families along a polyregular tag -/

/-- **The relation is closed under a case distinction driven by a polyregular tag.** -/
theorem Rel.glue : ∀ (H : HTy) {P : Ty} {t : P.Elt → Unit ⊕ Unit} {u v : P.Elt → H.Sem},
    IsPolyregularUnderRepr (A := P) (B := .sum .one .one) t → Rel H P u → Rel H P v →
    Rel H P (fun p => Sum.elim (fun _ => u p) (fun _ => v p) (t p)) := by
  intro H
  induction H with
  | one => intro _ _ _ _ _ _ _; trivial
  | prod A B ihA ihB =>
      intro P t u v ht hu hv
      constructor
      · refine (ihA ht hu.1 hv.1).congr (fun p => ?_)
        show Sum.elim (fun _ => (u p).1) (fun _ => (v p).1) (t p)
          = (Sum.elim (fun _ => u p) (fun _ => v p) (t p)).1
        cases t p <;> rfl
      · refine (ihB ht hu.2 hv.2).congr (fun p => ?_)
        show Sum.elim (fun _ => (u p).2) (fun _ => (v p).2) (t p)
          = (Sum.elim (fun _ => u p) (fun _ => v p) (t p)).2
        cases t p <;> rfl
  | sum A B ihA ihB =>
      intro P t u v ht hu hv
      obtain ⟨au, bu, hau, hbu, htagu, hconsu⟩ := hu
      obtain ⟨av, bv, hav, hbv, htagv, hconsv⟩ := hv
      refine ⟨fun p => Sum.elim (fun _ => au p) (fun _ => av p) (t p),
        fun p => Sum.elim (fun _ => bu p) (fun _ => bv p) (t p),
        ihA ht hau hav, ihB ht hbu hbv, ?_, ?_⟩
      · refine (IsPolyregularUnderRepr.cond ht htagu htagv).congr (fun p => ?_)
        show Sum.elim (fun _ => Sum.map (fun _ => ()) (fun _ => ()) (u p))
            (fun _ => Sum.map (fun _ => ()) (fun _ => ()) (v p)) (t p)
          = Sum.map (fun _ => ()) (fun _ => ())
            (Sum.elim (fun _ => u p) (fun _ => v p) (t p))
        cases t p <;> rfl
      · intro p
        cases hp : t p with
        | inl _ =>
            simp only [hp, Sum.elim_inl]
            exact hconsu p
        | inr _ =>
            simp only [hp, Sum.elim_inr]
            exact hconsv p
  | list A ihA =>
      intro P t u v ht hu hv
      obtain ⟨Qu, lu, eu, hlu, heu, hgu⟩ := hu
      obtain ⟨Qv, lv, ev, hlv, hev, hgv⟩ := hv
      refine ⟨.sum Qu Qv,
        fun p => Sum.elim (fun _ => (lu p).map Sum.inl) (fun _ => (lv p).map Sum.inr) (t p),
        fun x => Sum.elim (fun q => eu (x.1, q)) (fun q => ev (x.1, q)) x.2, ?_, ?_, ?_⟩
      · exact IsPolyregularUnderRepr.cond ht
          (hlu.comp (IsRegularUnderRepr.mapList
            (isRegularUnderRepr_inl Qu Qv)).isPolyregularUnderRepr)
          (hlv.comp (IsRegularUnderRepr.mapList
            (isRegularUnderRepr_inr Qu Qv)).isPolyregularUnderRepr)
      · -- the entries are glued along the tag of the index
        have htag' : IsPolyregularUnderRepr (A := .prod P (.sum Qu Qv)) (B := .sum .one .one)
            (fun x => Sum.map (fun _ => ()) (fun _ => ()) x.2) :=
          ((isRegularUnderRepr_snd P (.sum Qu Qv)).comp
            (isRegularUnderRepr_sumTag Qu Qv)).isPolyregularUnderRepr
        have hu' : Rel A (.prod P (.sum Qu Qv))
            (fun x => eu (x.1, Sum.elim (fun q => q) (fun _ => default) x.2)) := by
          refine Rel.reindex A (P := .prod P Qu) (Q := .prod P (.sum Qu Qv)) heu ?_
          exact IsPolyregularUnderRepr.prodMap
            (isRegularUnderRepr_id P).isPolyregularUnderRepr
            (isRegularUnderRepr_elimDefault Qu Qv).isPolyregularUnderRepr
        have hv' : Rel A (.prod P (.sum Qu Qv))
            (fun x => ev (x.1, Sum.elim (fun _ => default) (fun q => q) x.2)) := by
          refine Rel.reindex A (P := .prod P Qv) (Q := .prod P (.sum Qu Qv)) hev ?_
          exact IsPolyregularUnderRepr.prodMap
            (isRegularUnderRepr_id P).isPolyregularUnderRepr
            (isRegularUnderRepr_elimDefaultRight Qu Qv).isPolyregularUnderRepr
        refine (ihA htag' hu' hv').congr (fun x => ?_)
        obtain ⟨p, q⟩ := x
        cases q <;> rfl
      · intro p
        cases hp : t p with
        | inl _ =>
            simp only [hp, Sum.elim_inl]
            rw [hgu p, List.map_map]
            rfl
        | inr _ =>
            simp only [hp, Sum.elim_inr]
            rw [hgv p, List.map_map]
            rfl
  | arrow A B _ ihB =>
      intro P t u v ht hu hv Q r hr a ha
      refine (ihB (P := Q) (t := fun q => t (r q)) (hr.comp ht)
        ((hu Q r hr a ha).congr (fun _ => rfl))
        ((hv Q r hr a ha).congr (fun _ => rfl))).congr (fun q => ?_)
      show Sum.elim (fun _ => u (r q) (a q)) (fun _ => v (r q) (a q)) (t (r q))
        = Sum.elim (fun _ => u (r q)) (fun _ => v (r q)) (t (r q)) (a q)
      cases t (r q) <;> rfl

/-! ## The relation at arrow-free types -/

/-- **Lemma `lem:good-functions-are-polyregular-at-arrow-free-types`.**  If `Q` and `A` are
arrow-free, then the good functions of type `Q → A` are exactly the polyregular ones: at an
arrow-free type the relation says exactly that the family is polyregular under string
representation. -/
theorem Rel.iff_polyregular : ∀ (A : Ty) {P : Ty} (g : P.Elt → (HTy.ofTy A).Sem),
    Rel (HTy.ofTy A) P g ↔ IsPolyregularUnderRepr (fun p => HTy.toElt A (g p)) := by
  intro A
  induction A with
  | one =>
      intro P g
      constructor
      · intro _
        exact (isPolyregularUnderRepr_const (A := P) (B := .one) ()).congr (fun p => rfl)
      · intro _; trivial
  | prod A B ihA ihB =>
      intro P g
      constructor
      · intro h
        have h1 := (ihA (P := P) (fun p => (g p).1)).mp h.1
        have h2 := (ihB (P := P) (fun p => (g p).2)).mp h.2
        exact (IsPolyregularUnderRepr.pair h1 h2).congr (fun p => rfl)
      · intro h
        refine ⟨(ihA (P := P) (fun p => (g p).1)).mpr ?_,
          (ihB (P := P) (fun p => (g p).2)).mpr ?_⟩
        · exact (h.comp (isRegularUnderRepr_fst A B).isPolyregularUnderRepr).congr (fun p => rfl)
        · exact (h.comp (isRegularUnderRepr_snd A B).isPolyregularUnderRepr).congr (fun p => rfl)
  | sum A B ihA ihB =>
      intro P g
      constructor
      · rintro ⟨a, b, ha, hb, htag, hcons⟩
        have ha' := (ihA (P := P) a).mp ha
        have hb' := (ihB (P := P) b).mp hb
        refine (IsPolyregularUnderRepr.cond (C := .sum A B) htag
          (ha'.comp (isRegularUnderRepr_inl A B).isPolyregularUnderRepr)
          (hb'.comp (isRegularUnderRepr_inr A B).isPolyregularUnderRepr)).congr (fun p => ?_)
        rcases hcons p with hp | hp <;> rw [hp] <;> rfl
      · intro h
        refine ⟨fun p => HTy.ofElt A (Sum.elim (fun a => a) (fun _ => default)
            (HTy.toElt (.sum A B) (g p))),
          fun p => HTy.ofElt B (Sum.elim (fun _ => default) (fun b => b)
            (HTy.toElt (.sum A B) (g p))), ?_, ?_, ?_, ?_⟩
        · refine (ihA (P := P) _).mpr ?_
          refine (h.comp (isRegularUnderRepr_elimDefault A B).isPolyregularUnderRepr).congr
            (fun p => ?_)
          rw [HTy.toElt_ofElt]
        · refine (ihB (P := P) _).mpr ?_
          refine (h.comp
            (isRegularUnderRepr_elimDefaultRight A B).isPolyregularUnderRepr).congr (fun p => ?_)
          rw [HTy.toElt_ofElt]
        · refine (h.comp (isRegularUnderRepr_sumTag A B).isPolyregularUnderRepr).congr
            (fun p => ?_)
          cases g p with
          | inl x => simp [HTy.toElt]
          | inr x => simp [HTy.toElt]
        · intro p
          cases hgp : g p with
          | inl x =>
              refine Or.inl ?_
              show Sum.inl x = Sum.inl (HTy.ofElt A (Sum.elim (fun a => a) (fun _ => default)
                (HTy.toElt (.sum A B) (g p))))
              have h1 : HTy.toElt (.sum A B) (g p) = Sum.inl (HTy.toElt A x) := by
                rw [hgp]; rfl
              rw [h1]
              show Sum.inl x = Sum.inl (HTy.ofElt A (HTy.toElt A x))
              rw [HTy.ofElt_toElt]
          | inr x =>
              refine Or.inr ?_
              show Sum.inr x = Sum.inr (HTy.ofElt B (Sum.elim (fun _ => default) (fun b => b)
                (HTy.toElt (.sum A B) (g p))))
              have h1 : HTy.toElt (.sum A B) (g p) = Sum.inr (HTy.toElt B x) := by
                rw [hgp]; rfl
              rw [h1]
              show Sum.inr x = Sum.inr (HTy.ofElt B (HTy.toElt B x))
              rw [HTy.ofElt_toElt]
  | list A ihA =>
      intro P g
      constructor
      · rintro ⟨Q, l, e, hl, he, hg⟩
        have he' := (ihA (P := .prod P Q) e).mp he
        refine (IsPolyregularUnderRepr.mapParam hl he').congr (fun p => ?_)
        show ((l p).map (fun q => HTy.toElt A (e (p, q)))) = HTy.toElt (.list A) (g p)
        rw [hg p]
        show _ = ((l p).map (fun q => e (p, q))).map (HTy.toElt A)
        rw [List.map_map]
        rfl
      · intro h
        refine ⟨A, fun p => HTy.toElt (.list A) (g p), fun x => HTy.ofElt A x.2, h, ?_, ?_⟩
        · refine (ihA (P := .prod P A) _).mpr ?_
          refine (isRegularUnderRepr_snd P A).isPolyregularUnderRepr.congr (fun x => ?_)
          rw [HTy.toElt_ofElt]
        · intro p
          show g p = ((g p).map (HTy.toElt A)).map (fun x => HTy.ofElt A x)
          rw [List.map_map]
          rw [show ((fun x => HTy.ofElt A x) ∘ (HTy.toElt A)) = id from
            funext (fun x => HTy.ofElt_toElt A x)]
          exact (List.map_id _).symm

end Transducers
