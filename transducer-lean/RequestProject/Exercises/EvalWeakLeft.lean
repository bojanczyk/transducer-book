/-
Exercise `exer:weak-simon-tree-aperiodic` of Part D, Section *Evaluation*
(`partDPolyregular/evaluation.tex`): the induction step when no letter value shrinks the semigroup.

In the proof of the Factorisation Forest Theorem, when right multiplication by every letter value is
a permutation of the semigroup `T` generated by the letter values, the semigroup is handled as a
group (Lemma `lem:factorisation-forest-group`).  For an aperiodic monoid this case degenerates --
the book: "the group case will never arise": a permutation `t ↦ t·s` of `T` with `sⁿ⁺¹ = sⁿ` is
the identity, so `t·s = t` for every `t ∈ T` and every letter value `s`, and the value of every
nonempty string is the value of its first letter.

For a letter value `s`, a string is then decomposed as `d₀ · (c₁ b₁) ⋯ (cₖ bₖ) · cl`, with the `cᵢ`
nonempty runs of letters of value `s`, the `bᵢ` nonempty runs of other letters, `d₀` a run of
other letters and `cl` a run of value `s` (both possibly empty).  All the blocks `cᵢ bᵢ` and `cl`
start with `s`, so they all have the value `s`: they are the children of one flat node -- a weak
Simon node, whose label `s` need not be an idempotent.  This replaces the grouping into factors of
constant length of Lemma `lem:factorisation-forest-single-letter`, which would need modulo counting
(the book's remark).
-/
import RequestProject.Exercises.EvalWeakShrink

namespace Transducers.Exercises

open FactTree TreeSym Simon

section Left

variable {M : Type} [Monoid M] [DecidableEq M] (s : M) {NB : Type} [Monoid NB] (θB : M → NB)
  (GB : NB → NB → ℕ) (KB : ℕ)

/-- The rank function of this step: inside a run of `s`, `0`; between a run of `s` and a run of
other letters (inside a block), `KB + 1`; between two blocks, `KB + 2`; after `d₀`, `KB + 3`;
inside a run of other letters, the rank of the induction hypothesis. -/
def GF (P S : Run NB × Cut (fun _ : M => ())) : ℕ :=
  if Cut.lastS P.2 then (if Cut.firstS S.2 then 0 else KB + 1)
  else if Cut.firstS S.2 then (if Run.hasS P.1 then KB + 2 else KB + 3)
  else GB (Run.trail P.1) (Run.lead S.1)

variable {X : Type} (φ : X → M)

local notation "θU" => (fun _ : M => ())

/-- The string is empty or starts with a letter of value `s`. -/
def StartsS (u : List X) : Prop := u = [] ∨ ∃ x u', u = x :: u' ∧ φ x = s

omit [Monoid M] [DecidableEq M] in
lemma StartsS.flatten : ∀ {l : List (List X)}, (∀ y ∈ l, StartsS s φ y) → StartsS s φ l.flatten
  | [], _ => Or.inl rfl
  | y :: l, h => by
    rw [List.flatten_cons]
    rcases h y (by simp) with rfl | ⟨x, u', rfl, hx⟩
    · exact StartsS.flatten fun z hz => h z (by simp [hz])
    · exact Or.inr ⟨x, u' ++ l.flatten, by simp, hx⟩

omit [Monoid M] in
lemma lead_of_startsS {u : List X} (h : StartsS s φ u) :
    Run.lead (val (thR s θB ∘ φ) u) = 1 := by
  rcases h with rfl | ⟨x, u', rfl, hx⟩
  · rfl
  · have := lead_startsS s θB φ (u := u') hx 1
    rwa [mul_one] at this

lemma repL_run {u : List X} (hns : ∀ x ∈ u, φ x ≠ s) {t : FactTree X}
    (ht : Rep φ (θB ∘ φ) GB KB 1 1 t u) {α β : Run NB × Cut θU}
    (hα : Run.trail α.1 = 1) (hβ : Run.lead β.1 = 1) :
    Rep φ (thS s θB θU ∘ φ) (GF GB KB) KB α β t u := by
  refine ht.congr fun u₁ u₂ h₁ h₂ h => ?_
  have hns₁ : ∀ x ∈ u₁, φ x ≠ s := fun x hx => hns x (mem_left_of_append h hx)
  have hns₂ : ∀ x ∈ u₂, φ x ≠ s := fun x hx => hns x (mem_right_of_append h hx)
  rw [val_thS, val_thS, valR_ns s θB φ u₁ hns₁, valR_ns s θB φ u₂ hns₂,
    valC_ns s θU φ u₁ h₁ hns₁, valC_ns s θU φ u₂ h₂ hns₂]
  simp [GF, Cut.lastS_mul_pc, Cut.firstS_pc_mul, Run.trail_mul_ns, Run.lead_ns_mul, hα, hβ]

lemma repL_flat {c : List X} (hc : c ≠ []) (hs : ∀ x ∈ c, φ x = s) (α β : Run NB × Cut θU) :
    Rep φ (thS s θB θU ∘ φ) (GF GB KB) 0 α β (flat c) c := by
  refine Rep.flat hc hs fun u v hu hv h => ?_
  obtain ⟨u', x, rfl⟩ := (List.eq_nil_or_concat u).resolve_left hu
  obtain ⟨y, v', rfl⟩ := List.exists_cons_of_ne_nil hv
  simp only [List.concat_eq_append] at *
  have hx : φ x = s := hs x (mem_left_of_append h (by simp))
  have hy : φ y = s := hs y (mem_right_of_append h (by simp))
  rw [val_thS, val_thS]
  simp only [GF, Prod.snd_mul, lastS_last, firstS_first, hx, hy, decide_true, if_true]

/-- A block `c b` of this step. -/
lemma repL_block {c b : List X} (hc : c ≠ []) (hb : b ≠ []) (hcs : ∀ x ∈ c, φ x = s)
    (hbs : ∀ x ∈ b, φ x ≠ s) {tb : FactTree X} (htb : Rep φ (θB ∘ φ) GB KB 1 1 tb b)
    {α β : Run NB × Cut θU} (hβ : Run.lead β.1 = 1) :
    Rep φ (thS s θB θU ∘ φ) (GF GB KB) (KB + 1) α β
      (.node [padT KB (flat c), tb]) (c ++ b) := by
  obtain ⟨y, b', rfl⟩ := List.exists_cons_of_ne_nil hb
  obtain ⟨c', x, rfl⟩ := (List.eq_nil_or_concat c).resolve_left hc
  simp only [List.concat_eq_append] at *
  have hy : φ y ≠ s := hbs y (by simp)
  have hx : φ x = s := hcs x (by simp)
  refine Rep.two ?_ (repL_run s θB GB KB φ hbs htb ?_ hβ) ?_
  · have := (repL_flat s θB GB KB φ hc hcs α (val (thS s θB θU ∘ φ) (y :: b') * β)).padN KB
    rwa [zero_add] at this
  · rw [val_thS, Prod.fst_mul, valR_s s θB φ _ hc hcs]
    exact Run.trail_mul_sv _ _ _
  · rw [val_thS, val_thS]
    simp only [GF, Prod.snd_mul, lastS_last, firstS_first, hx, hy, decide_true, decide_false,
      if_true, Bool.false_eq_true, if_false]

omit [Monoid M] [DecidableEq M] in
lemma mem_of_append_short {α : Type} {pre post A E : List α} (h : pre ++ post = A ++ E)
    (hE : E.length ≤ 1) (hpost : post ≠ []) : ∀ z ∈ pre, z ∈ A := by
  rcases List.append_eq_append_iff.mp h with ⟨a', rfl, -⟩ | ⟨c', rfl, hE'⟩
  · exact fun z hz => List.mem_append_left _ hz
  · have : c' = [] := by
      rw [hE'] at hE
      simp only [List.length_append] at hE
      have : post.length ≠ 0 := by simpa using hpost
      exact List.eq_nil_of_length_eq_zero (by omega)
    subst this
    simp

/-- **The step without a shrinking letter value**, for one alphabet: if every nonempty string
starting with a letter of value `s` has value `s`, then from the trees of the runs of other letters
a tree for every string. -/
lemma left_rep (Q : X → Prop)
    (hKB : ∀ u : List X, u ≠ [] → (∀ x ∈ u, Q x ∧ φ x ≠ s) →
      ∃ t, Rep φ (θB ∘ φ) GB KB 1 1 t u)
    (hval : ∀ (x : X) (u : List X), φ x = s → Q x → (∀ y ∈ u, Q y) → val φ (x :: u) = s)
    (w : List X) (hw : w ≠ []) (hQ : ∀ x ∈ w, Q x) :
    ∃ t, Rep φ (thS s θB θU ∘ φ) (GF GB KB) (KB + 3) 1 1 t w := by
  classical
  have hKB' : ∀ u : List X, ∃ t, u ≠ [] → (∀ x ∈ u, Q x ∧ φ x ≠ s) →
      Rep φ (θB ∘ φ) GB KB 1 1 t u := by
    intro u
    by_cases h : u ≠ [] ∧ ∀ x ∈ u, Q x ∧ φ x ≠ s
    · obtain ⟨t, ht⟩ := hKB u h.1 h.2
      exact ⟨t, fun _ _ => ht⟩
    · exact ⟨.node [], fun h1 h2 => absurd ⟨h1, h2⟩ h⟩
  choose tB htB using hKB'
  set ψ := thS s θB θU ∘ φ with hψ
  set G := GF GB KB with hG
  set p : X → Bool := fun x => decide (φ x = s) with hp
  set f : List X → FactTree X := fun y => if y.dropWhile p = [] then padT (KB + 1) (flat y)
    else .node [padT KB (flat (y.takeWhile p)), tB (y.dropWhile p)] with hf
  obtain ⟨d₀, ps, cl, hdec, hd₀, hps, hcl⟩ := exists_decomp (fun x => φ x ≠ s) w
  simp only [ne_eq, not_not] at hps hcl
  have hmem : ∀ x, x ∈ d₀ ∨ (∃ p ∈ ps, x ∈ p.1 ∨ x ∈ p.2) ∨ x ∈ cl → x ∈ w := by
    intro x hx'
    rw [hdec]
    rcases hx' with h | ⟨p, hp, h⟩ | h
    · simp [h]
    · simp only [List.mem_append, List.mem_flatMap]
      exact Or.inl (Or.inr ⟨p, hp, h⟩)
    · simp [h]
  set A := ps.map (fun p => p.1 ++ p.2) with hA
  set E : List (List X) := if cl = [] then [] else [cl] with hE
  set v := A ++ E with hv
  have hEl : E.length ≤ 1 := by rw [hE]; split_ifs <;> simp
  have hvflat : ps.flatMap (fun p => p.1 ++ p.2) ++ cl = v.flatten := by
    rw [hv, List.flatten_append, hA, ← List.flatMap_def, hE]
    split_ifs with h <;> simp [h]
  -- the blocks
  have hAb : ∀ y ∈ A, ∃ c b, y = c ++ b ∧ c ≠ [] ∧ b ≠ [] ∧ (∀ x ∈ c, φ x = s) ∧
      (∀ x ∈ b, φ x ≠ s) ∧ ∀ x ∈ y, Q x := by
    intro y hy
    obtain ⟨⟨c, b⟩, hpc, rfl⟩ := List.mem_map.mp hy
    obtain ⟨hc, hb, hcs, hbs⟩ := hps (c, b) hpc
    refine ⟨c, b, rfl, hc, hb, hcs, hbs, fun x hx => hQ x (hmem x ?_)⟩
    rcases List.mem_append.mp hx with h | h
    · exact Or.inr (Or.inl ⟨(c, b), hpc, Or.inl h⟩)
    · exact Or.inr (Or.inl ⟨(c, b), hpc, Or.inr h⟩)
  have hEb : ∀ y ∈ E, y ≠ [] ∧ (∀ x ∈ y, φ x = s) ∧ ∀ x ∈ y, Q x := by
    intro y hy
    rw [hE] at hy
    split_ifs at hy with h
    · simp at hy
    · simp only [List.mem_singleton] at hy
      subst hy
      exact ⟨h, hcl, fun x hx => hQ x (hmem x (Or.inr (Or.inr hx)))⟩
  have hvS : ∀ y ∈ v, StartsS s φ y ∧ y ≠ [] ∧ ∀ x ∈ y, Q x := by
    intro y hy
    rcases List.mem_append.mp hy with hy | hy
    · obtain ⟨c, b, rfl, hc, hb, hcs, -, hyQ⟩ := hAb y hy
      obtain ⟨x, c', rfl⟩ := List.exists_cons_of_ne_nil hc
      exact ⟨Or.inr ⟨x, c' ++ b, rfl, hcs x (by simp)⟩, by simp, hyQ⟩
    · obtain ⟨hy0, hys, hyQ⟩ := hEb y hy
      obtain ⟨x, y', rfl⟩ := List.exists_cons_of_ne_nil hy0
      exact ⟨Or.inr ⟨x, y', rfl, hys x (by simp)⟩, hy0, hyQ⟩
  have hfrep : ∀ y ∈ v, ∀ α β : Run NB × Cut θU, Run.lead β.1 = 1 →
      Rep φ ψ G (KB + 1) α β (f y) y := by
    intro y hy α β hβ
    rcases List.mem_append.mp hy with hy | hy
    · obtain ⟨c, b, rfl, hc, hb, hcs, hbs, hyQ⟩ := hAb y hy
      obtain ⟨y0, b', rfl⟩ := List.exists_cons_of_ne_nil hb
      have hTD := takeWhile_dropWhile_block p (b := c) (c := y0 :: b')
        (fun x hx => by simp [hp, hcs x hx]) (fun x hx => by
          have hx' : x = y0 := by simpa using hx.symm
          simp [hp, show φ x ≠ s by rw [hx']; exact hbs y0 (by simp)])
      simp only [hf, hTD.2.1, hTD.2.2, reduceCtorEq, if_false]
      exact repL_block s θB GB KB φ hc hb hcs hbs
        (htB _ hb fun x hx => ⟨hyQ x (by simp [hx]), hbs x hx⟩) hβ
    · obtain ⟨hy0, hys, -⟩ := hEb y hy
      have : y.dropWhile p = [] := by
        rw [List.dropWhile_eq_nil_iff]
        intro x hx
        simp [hp, hys x hx]
      simp only [hf, this, if_true]
      have := (repL_flat s θB GB KB φ hy0 hys α β).padN (KB + 1)
      rwa [zero_add] at this
  have hblocks : v ≠ [] → ∃ tb, Rep φ ψ G (KB + 2) (val ψ d₀) 1 tb v.flatten := by
    intro hv0
    have hout : Rep (val φ) (fun _ : List X => ()) (fun _ _ => 0) 0 1 1 (flat v) v :=
      Rep.flat hv0 (s := s) (fun y hy => by
        obtain ⟨h1, h2, h3⟩ := hvS y hy
        rcases h1 with h1 | ⟨x, u, rfl, hx⟩
        · exact absurd h1 h2
        · exact hval x u hx (h3 x (by simp)) fun z hz => h3 z (by simp [hz]))
        (fun _ _ _ _ _ => rfl)
    obtain ⟨hTy, hTws, hTh, v0, vs, hv0', hTe⟩ := hout
    refine ⟨_, (Rep.subst (Kb := KB + 1) f hTy hTws hTh ⟨v0, vs, hv0', hTe⟩ ?_ ?_).castK
      (by omega)⟩
    · intro pre y post h
      have hyv : y ∈ v := h ▸ by simp
      refine hfrep y hyv _ _ ?_
      rw [hψ, val_thS, mul_one]
      exact lead_of_startsS s θB φ (StartsS.flatten s φ fun z hz =>
        (hvS z (h ▸ List.mem_append_right _ (List.mem_cons_of_mem _ hz))).1)
    · intro pre post hpre hpost h
      have hpreA := mem_of_append_short h hEl hpost
      obtain ⟨pre', z, hz⟩ := (List.eq_nil_or_concat pre).resolve_left hpre
      subst hz
      obtain ⟨c, b, rfl, hc, hb, hcs, hbs, -⟩ := hAb z (hpreA z (by simp))
      obtain ⟨b', x, rfl⟩ := (List.eq_nil_or_concat b).resolve_left hb
      obtain ⟨y0, post', rfl⟩ := List.exists_cons_of_ne_nil hpost
      obtain ⟨hy0S, hy0ne, -⟩ := hvS y0 (h ▸ by simp)
      obtain ⟨u0, u', rfl⟩ := List.exists_cons_of_ne_nil hy0ne
      have hu0 : φ u0 = s := by
        rcases hy0S with h' | ⟨x', u'', h', hx'⟩
        · simp at h'
        · obtain ⟨rfl, -⟩ := List.cons_eq_cons.mp h'; exact hx'
      simp only [List.concat_eq_append] at *
      have hx : φ x ≠ s := hbs x (by simp)
      have hcS : ∃ z ∈ d₀ ++ (pre' ++ [c ++ (b' ++ [x])]).flatten, φ z = s := by
        obtain ⟨x', c', rfl⟩ := List.exists_cons_of_ne_nil hc
        exact ⟨x', by simp, hcs x' (by simp)⟩
      have h1 : (d₀ ++ (pre' ++ [c ++ (b' ++ [x])]).flatten) =
          (d₀ ++ pre'.flatten ++ (c ++ b')) ++ [x] := by simp
      have h2 : ((u0 :: u') :: post').flatten = u0 :: (u' ++ post'.flatten) := by simp
      rw [hψ, ← val_append, h2, mul_one, val_thS, val_thS]
      have hl := lastS_last s θU φ 1 (d₀ ++ pre'.flatten ++ (c ++ b')) x
      have hf' := firstS_first s θU φ 1 (u' ++ post'.flatten) u0
      rw [← h1, one_mul] at hl
      rw [mul_one] at hf'
      simp only [hG, GF, hl, hf', hx, hu0, decide_true, decide_false, Bool.false_eq_true,
        if_false, if_true, hasS_of_mem s θB φ hcS]
      omega
  -- the root
  rw [hdec, List.append_assoc, hvflat]
  by_cases hd0 : d₀ = []
  · subst hd0
    have hv0 : v ≠ [] := by
      rintro h; apply hw; rw [hdec, List.append_assoc, hvflat, h]; rfl
    obtain ⟨tb, htb⟩ := hblocks hv0
    exact ⟨_, (htb.pad.castK (K' := KB + 3) (by omega)).ctx rfl rfl⟩
  · have hd1 := htB d₀ hd0 fun x hx => ⟨hQ x (hmem x (Or.inl hx)), hd₀ x hx⟩
    by_cases hv0 : v = []
    · rw [hv0, List.flatten_nil, List.append_nil]
      have h1 := repL_run s θB GB KB φ hd₀ hd1 (α := 1) (β := 1) (by rfl) (by rfl)
      exact ⟨_, (h1.padN 3).castK (by omega)⟩
    · obtain ⟨tb, htb⟩ := hblocks hv0
      have hvS' : StartsS s φ v.flatten := StartsS.flatten s φ fun z hz => (hvS z hz).1
      have h1 := repL_run s θB GB KB φ hd₀ hd1 (α := 1) (β := val ψ v.flatten * 1) (by rfl) (by
        rw [mul_one, hψ, val_thS]
        exact lead_of_startsS s θB φ hvS')
      refine ⟨_, (Rep.two ((h1.padN 2).castK (by omega)) (htb.ctx (by rw [one_mul]) rfl)
        ?_).castK (by omega)⟩
      obtain ⟨d', x, rfl⟩ := (List.eq_nil_or_concat d₀).resolve_left hd0
      obtain ⟨y, v', hy⟩ := List.exists_cons_of_ne_nil
        (show v.flatten ≠ [] by
          obtain ⟨z, v'', hz⟩ := List.exists_cons_of_ne_nil hv0
          have := (hvS z (by rw [hz]; simp)).2.1
          rw [hz]; simp [this])
      simp only [List.concat_eq_append] at *
      have hx : φ x ≠ s := hd₀ x (by simp)
      have hys : φ y = s := by
        rcases hvS' with h' | ⟨y', v'', h', hy'⟩
        · rw [hy] at h'; simp at h'
        · rw [hy] at h'; obtain ⟨rfl, -⟩ := List.cons_eq_cons.mp h'; exact hy'
      have hl := lastS_last s θU φ 1 d' x
      have hf' := firstS_first s θU φ 1 v' y
      rw [one_mul] at hl
      rw [mul_one] at hf'
      rw [hy, val_thS, val_thS]
      simp only [one_mul, mul_one, GF, hl, hf', hx, hys, decide_true, decide_false,
        Bool.false_eq_true, if_false, if_true, hasS_of_all_ns s θB φ hd₀]

end Left

end Transducers.Exercises
