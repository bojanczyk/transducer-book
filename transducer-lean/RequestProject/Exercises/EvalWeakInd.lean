/-
Exercise `exer:weak-simon-tree-aperiodic` of Part D, Section *Evaluation*
(`partDPolyregular/evaluation.tex`): the induction.

The induction of the proof of the Factorisation Forest Theorem (as formalised in
`Transducers.Simon.good_closed`), on the size of the semigroup `T` generated by the letter values and
on the number of letter values, now producing representations `Transducers.Exercises.Rep` whose
ranks are computed in a finite aperiodic monoid (`Transducers.Exercises.WGood`).

* If a letter value `s` shrinks `T` on the right, the step of `EvalWeakShrink.lean` applies.
* Otherwise right multiplication by every letter value is injective on `T`; as the monoid is
  aperiodic, it is then the identity on `T` (the book: "the group case will never arise"), and the
  step of `EvalWeakLeft.lean` applies.
-/
import RequestProject.Exercises.EvalWeakLeft

namespace Transducers.Exercises

open FactTree TreeSym Simon

variable {M : Type} [Monoid M]

lemma wgood_empty : WGood ((∅ : Finset M) : Set M) := by
  refine ⟨0, Unit, inferInstance, inferInstance, fun _ => ⟨0, rfl⟩, fun _ => (), fun _ _ => 0,
    fun X φ w hw hx => ?_⟩
  obtain ⟨x, hxw⟩ := List.exists_mem_of_ne_nil w hw
  simpa using hx x hxw

variable [DecidableEq M]

lemma wgood_shrink [Finite M] (hM : Aper M) {T L : Finset M} (hT : Closed T) (hLT : L ⊆ T)
    {s : M} (hB : WGood ((L.erase s : Finset M) : Set M))
    (hC : WGood ((T.image (· * s) : Finset M) : Set M)) : WGood (L : Set M) := by
  obtain ⟨KB, NB, _, _, hNB, θB, GB, hKB⟩ := hB
  obtain ⟨KO, NO, _, _, hNO, θO, GO, hKO⟩ := hC
  refine ⟨KO + KB + 4, Run NB × Cut θO, inferInstance, inferInstance,
    Aper.prod (aper_run hNB) (aper_cut hM hNO), thS s θB θO, GS θO GB GO KB KO,
    fun X φ w hw hx => ?_⟩
  refine shrink_rep s θB θO GB GO KB KO φ (fun x => φ x ∈ L) ?_ ?_ w hw hx
  · intro u hu hu'
    exact hKB X φ u hu fun x hxu =>
      Finset.mem_coe.mpr (Finset.mem_erase.mpr ⟨(hu' x hxu).2, (hu' x hxu).1⟩)
  · intro v hv hv'
    refine hKO (List X) (val φ) v hv fun y hy => ?_
    obtain ⟨⟨b, c, rfl, hb, hc, -, hcs⟩, hyL⟩ := hv' y hy
    obtain ⟨c', z, rfl⟩ := (List.eq_nil_or_concat c).resolve_left hc
    have hT' : val φ (b ++ c') ∈ T := by
      refine val_mem hT (by simp [hb]) fun x hx' => hLT (hyL x ?_)
      rcases List.mem_append.mp hx' with h | h
      · exact List.mem_append_left _ h
      · exact List.mem_append_right _ (by simp [h])
    refine Finset.mem_coe.mpr (Finset.mem_image.mpr ⟨val φ (b ++ c'), hT', ?_⟩)
    have hz : φ z = s := hcs z (by simp)
    simp only [List.concat_eq_append]
    rw [← List.append_assoc, val_append φ (b ++ c'), val_singleton, hz]

omit [DecidableEq M] in
lemma val_left_absorb {X : Type} {L : Finset M} {s : M} (hs : ∀ m ∈ L, s * m = s) (φ : X → M) :
    ∀ u : List X, (∀ y ∈ u, φ y ∈ L) → s * val φ u = s
  | [], _ => by simp
  | y :: u, h => by
    rw [val_cons, ← mul_assoc, hs _ (h y (by simp)),
      val_left_absorb hs φ u fun z hz => h z (by simp [hz])]

lemma wgood_left [Finite M] (hM : Aper M) {L : Finset M} {s : M} (hs : ∀ m ∈ L, s * m = s)
    (hB : WGood ((L.erase s : Finset M) : Set M)) : WGood (L : Set M) := by
  obtain ⟨KB, NB, _, _, hNB, θB, GB, hKB⟩ := hB
  refine ⟨KB + 3, Run NB × Cut (fun _ : M => ()), inferInstance, inferInstance,
    Aper.prod (aper_run hNB) (aper_cut hM (fun _ => ⟨0, rfl⟩)),
    thS s θB (fun _ : M => ()), GF GB KB, fun X φ w hw hx => ?_⟩
  refine left_rep s θB GB KB φ (fun x => φ x ∈ L) ?_ ?_ w hw hx
  · intro u hu hu'
    exact hKB X φ u hu fun x hxu =>
      Finset.mem_coe.mpr (Finset.mem_erase.mpr ⟨(hu' x hxu).2, (hu' x hxu).1⟩)
  · intro x u hxs _ hu
    rw [val_cons, hxs]
    exact val_left_absorb hs φ u hu

omit [DecidableEq M] in
/-- In an aperiodic monoid, if right multiplication by a letter value `s` is injective on the
finite subsemigroup `T`, then it is the identity on `T`. -/
lemma mul_eq_self_of_injOn (hM : Aper M) {T L : Finset M} (hT : Closed T) (hLT : L ⊆ T)
    (hL : ∀ s ∈ L, Set.InjOn (· * s) T) {s : M} (hs : s ∈ L) {t : M} (ht : t ∈ T) :
    t * s = t := by
  obtain ⟨n, hn⟩ := hM s
  have hinj := injOn_mul_prod hT hLT hL (List.replicate (n + 1) s) (by simp)
    (fun a ha => by rw [(List.mem_replicate.mp ha).2]; exact hs)
  simp only [List.prod_replicate] at hinj
  refine hinj (hT _ ht _ (hLT hs)) ht ?_
  show t * s * s ^ (n + 1) = t * s ^ (n + 1)
  rw [mul_assoc, ← pow_succ', pow_stable hn (n + 1 + 1) (by omega),
    pow_stable hn (n + 1) (by omega)]

/-- The induction: for every finite subsemigroup `T` of a finite aperiodic monoid and every set
`L ⊆ T` of letter values, `WGood L`. -/
theorem wgood_closed [Finite M] (hM : Aper M) :
    ∀ (n : ℕ) (T : Finset M), T.card ≤ n → Closed T → ∀ L ⊆ T, WGood (L : Set M) := by
  intro n
  induction n with
  | zero =>
    intro T hTc _ L hLT
    have : T = ∅ := Finset.card_eq_zero.mp (by omega)
    subst this
    rw [Finset.subset_empty.mp hLT]
    exact wgood_empty
  | succ n ihT =>
    intro T hTc hT
    have key : ∀ m, ∀ L ⊆ T, L.card ≤ m → WGood (L : Set M) := by
      intro m
      induction m with
      | zero =>
        intro L _ hLc
        have : L = ∅ := Finset.card_eq_zero.mp (by omega)
        rw [this]
        exact wgood_empty
      | succ m ihL =>
        intro L hLT hLc
        by_cases hshr : ∃ s ∈ L, T.image (· * s) ≠ T
        · obtain ⟨s, hs, hTs⟩ := hshr
          have hsT : s ∈ T := hLT hs
          have hsub : T.image (· * s) ⊆ T := by
            intro m hm
            obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hm
            exact hT _ ht _ hsT
          have hlt : (T.image (· * s)).card < T.card :=
            Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr ⟨hsub, hTs⟩)
          have hclosed : Closed (T.image (· * s)) := by
            intro a ha b hb
            obtain ⟨a', ha', rfl⟩ := Finset.mem_image.mp ha
            obtain ⟨b', hb', rfl⟩ := Finset.mem_image.mp hb
            refine Finset.mem_image.mpr ⟨a' * s * b', hT _ (hT _ ha' _ hsT) _ hb', ?_⟩
            simp [mul_assoc]
          refine wgood_shrink hM hT hLT (s := s) ?_ ?_
          · refine ihL (L.erase s) (subset_trans (Finset.erase_subset _ _) hLT) ?_
            rw [Finset.card_erase_of_mem hs]; omega
          · exact ihT _ (by omega) hclosed _ subset_rfl
        · push_neg at hshr
          have hinjL : ∀ s ∈ L, Set.InjOn (· * s) T := fun s hs =>
            Finset.injOn_of_card_image_eq (by rw [hshr s hs])
          rcases L.eq_empty_or_nonempty with hL | ⟨s, hs⟩
          · rw [hL]; exact wgood_empty
          · refine wgood_left hM (s := s) (fun m hm => mul_eq_self_of_injOn hM hT hLT hinjL hm
              (hLT hs)) ?_
            refine ihL (L.erase s) (subset_trans (Finset.erase_subset _ _) hLT) ?_
            rw [Finset.card_erase_of_mem hs]; omega
    exact fun L hLT => key L.card L hLT le_rfl

/-- Every finite aperiodic monoid: `WGood` for the set of all its elements. -/
theorem wgood_univ [Fintype M] (hM : Aper M) : WGood ((Finset.univ : Finset M) : Set M) :=
  wgood_closed hM _ Finset.univ le_rfl (fun _ _ _ _ => Finset.mem_univ _) _ subset_rfl

end Transducers.Exercises
